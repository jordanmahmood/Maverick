# Copy to .env and fill in. Never commit .env.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MAVERICK_CHECK_MODEL=gpt-5.6-luna    # step checks
MAVERICK_PARSE_MODEL=gpt-5.5         # booklet parsing
# Optional
MAVERICK_MOCK=0          # 1 = never call the model
MAVERICK_GUIDE=          # path to another guide JSON
MAVERICK_RECORD=         # folder: save checked frames and verdicts (only with "keep pictures" on)
