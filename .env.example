# Copy to .env and fill in. Never commit .env.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
MAVERICK_CHECK_MODEL=gpt-5.6-luna    # step checks
MAVERICK_PARSE_MODEL=gpt-5.5         # booklet parsing
MAVERICK_LOCATE_MODEL=gpt-5.6-luna   # AR target/box locating
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional
MAVERICK_MOCK=0          # 1 = never call the model
MAVERICK_GUIDE=          # path to another guide JSON
MAVERICK_RECORD=         # folder: save checked frames and verdicts (only with "keep pictures" on)
MAVERICK_KEEP_FRAMES=0   # 1 = save every camera frame
MAVERICK_VOICE_OFF=0     # 1 = disable Azure TTS/STT
MAVERICK_TTS_MODEL=gpt-4o-mini-tts
MAVERICK_STT_MODEL=gpt-4o-mini-transcribe
MAVERICK_VOICE=coral
MAVERICK_DETECT_SIZE=960
MAVERICK_DETECT_CONF=0.30
MAVERICK_LOCATE_SIDE=1280
MAVERICK_LOCATE_CONFIDENCE=0.6
